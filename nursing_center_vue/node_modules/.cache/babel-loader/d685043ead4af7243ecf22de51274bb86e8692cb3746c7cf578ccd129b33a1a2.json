{"ast":null,"code":"import Clock from \"../../components/Clock\";\nexport default {\n  name: \"收费\",\n  data() {\n    return {\n      patient: {\n        caseNumber: '',\n        realName: '',\n        gender: '',\n        cardNumber: '',\n        deptmentId: '',\n        employeeId: '',\n        registerLevelId: '',\n        settleCategoryId: '',\n        isBook: false,\n        registerMethod: '',\n        registerMoney: '',\n        number: '',\n        initialAmount: '',\n        usedAmount: '',\n        receivableAmount: '',\n        visitState: ''\n      },\n      payPatient: {\n        caseNumber: ''\n      },\n      patientList: [],\n      priceList: []\n    };\n  },\n  methods: {\n    reset() {},\n    exactSelect() {\n      // 根据病历号或者身份证号进行查询病人信息\n      if (this.patient.caseNumber !== '') {\n        this.$request.post('/register/selectByCaseNumber', this.patient).then(res => {\n          if (res.code === '200') {\n            this.patientList = res.data;\n            this.$message.success('查询成功');\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      } else if (this.patient.cardNumber !== '') {\n        this.$request.post('/register/selectByCardNumber', this.patient).then(res => {\n          if (res.code === '200') {\n            this.patientList = res.data;\n            this.$message.success('查询成功');\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      } else {\n        this.$message.error('请输入病历号或者身份证号');\n      }\n    },\n    pay() {\n      // 当选择完之后，再进行收费\n      this.$request.post('/register/pay', this.payPatient).then(res => {\n        if (res.code === '200') {\n          this.$message.success('收费成功');\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    selectPriceList(index, row) {\n      // 当点击收费的时候，就进行展示该病人都用了的项目\n      this.$request.post('/medical-technology/selectPriceList', row).then(res => {\n        if (res.code === '200') {\n          this.priceList = res.data;\n          this.payPatient.caseNumber = row.caseNumber;\n          this.$message.success('查询成功');\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    handleDelete() {\n      alert(\"删除\");\n    }\n  },\n  created() {},\n  components: {\n    Clock\n  }\n};","map":{"version":3,"names":["Clock","name","data","patient","caseNumber","realName","gender","cardNumber","deptmentId","employeeId","registerLevelId","settleCategoryId","isBook","registerMethod","registerMoney","number","initialAmount","usedAmount","receivableAmount","visitState","payPatient","patientList","priceList","methods","reset","exactSelect","$request","post","then","res","code","$message","success","error","msg","pay","selectPriceList","index","row","handleDelete","alert","created","components"],"sources":["src/views/manager/Toll.vue"],"sourcesContent":["<template xmlns=\"http://www.w3.org/1999/html\">\r\n  <div>\r\n    <el-card>\r\n      <h2>收费</h2>\r\n      <br>\r\n      <hr>\r\n      <br>\r\n      <Clock/>\r\n      <br>\r\n    </el-card>\r\n    <el-card style=\"margin-top: 10px\">\r\n      <span style=\"font-size: 17px\">患者选择</span>\r\n      <div style=\"margin-top: 10px\">\r\n        <el-form :inline=\"true\" :model=\"patient\" class=\"demo-form-inline\">\r\n          <el-form-item label=\"病历号:\">\r\n            <el-input v-model=\"patient.caseNumber\" placeholder=\"病历号\" clearable/>\r\n          </el-form-item>\r\n          <el-form-item label=\"身份证号:\">\r\n            <el-input v-model=\"patient.cardNumber\" placeholder=\"身份证号\" clearable/>\r\n          </el-form-item>\r\n          <el-button type=\"primary\" @click=\"exactSelect\">查询</el-button>\r\n          <el-button type=\"primary\" @click=\"reset\">重置</el-button>\r\n        </el-form>\r\n      </div>\r\n      <!--展示出所选择的挂号信息-->\r\n      <span style=\"font-size: 17px\">所选择的患者信息</span>\r\n      <div style=\"margin-top: 10px\">\r\n        <el-table\r\n            :data=\"patientList\"\r\n            style=\"width: 100%\"\r\n        >\r\n          <el-table-column label=\"病历号\" width=\"180\">\r\n            <template #default=\"scope\">\r\n              <div style=\"display: flex; align-items: center\">\r\n                <el-icon>\r\n                  <timer/>\r\n                </el-icon>\r\n                <span style=\"margin-left: 10px\">{{ scope.row.caseNumber }}</span>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n\r\n          <el-table-column label=\"姓名\" width=\"180\">\r\n            <template #default=\"scope\">\r\n              <el-popover effect=\"light\" trigger=\"hover\" placement=\"top\" width=\"auto\">\r\n                <template #default>\r\n                  <div>身份证号: {{ scope.row.cardNumber }}</div>\r\n                  <div>住址: {{ scope.row.address }}</div>\r\n                  <div>年龄: {{ scope.row.age }}</div>\r\n                </template>\r\n                <template #reference>\r\n                  <el-tag>{{ scope.row.realName }}</el-tag>\r\n                </template>\r\n              </el-popover>\r\n            </template>\r\n          </el-table-column>\r\n\r\n          <el-table-column label=\"挂号科室\" width=\"180\">\r\n            <template #default=\"scope\">\r\n              <div style=\"display: flex; align-items: center\">\r\n                <el-icon>\r\n                  <timer/>\r\n                </el-icon>\r\n                <span style=\"margin-left: 10px\">{{ scope.row.caseNumber }}</span>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column label=\"状态\" width=\"180\">\r\n            <template #default=\"scope\">\r\n              <div style=\"display: flex; align-items: center\">\r\n                <el-icon>\r\n                  <timer/>\r\n                </el-icon>\r\n                <span v-if=\"scope.row.visitState === '1'\" style=\"margin-left: 10px\">未看诊</span>\r\n                <span v-if=\"scope.row.visitState === '2'\" style=\"margin-left: 10px\">医生接诊</span>\r\n                <span v-if=\"scope.row.visitState === '3'\" style=\"margin-left: 10px\">看诊完毕</span>\r\n                <span v-if=\"scope.row.visitState === '4'\" style=\"margin-left: 10px\">退号</span>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column align=\"right\">\r\n            <template #header>\r\n            </template>\r\n            <template #default=\"scope\">\r\n              <el-button size=\"small\" @click=\"selectPriceList(scope.$index, scope.row)\">\r\n                交费\r\n              </el-button>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n      </div>\r\n    </el-card>\r\n    <!--    下半部分-->\r\n    <el-card style=\"margin-top: 10px\">\r\n      <span style=\"font-size: 17px\">总金额：{{ money }}</span>\r\n      <el-button type=\"primary\" @click=\"pay\">\r\n        支付\r\n      </el-button>\r\n      <el-table\r\n          :data=\"priceList\"\r\n          style=\"width: 100%;margin-top: 10px\"\r\n      >\r\n        <el-table-column label=\"项目\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.caseNumber }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"单价\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <el-popover effect=\"light\" trigger=\"hover\" placement=\"top\" width=\"auto\">\r\n              <template #default>\r\n                <div>身份证号: {{ scope.row.cardNumber }}</div>\r\n              </template>\r\n              <template #reference>\r\n                <el-tag>{{ scope.row.realName }}</el-tag>\r\n              </template>\r\n            </el-popover>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"数量\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.caseNumber }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"开设时间\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.caseNumber }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column align=\"right\">\r\n          <template #header>\r\n\r\n          </template>\r\n          <template #default=\"scope\">\r\n\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n<script>\r\nimport Clock from \"../../components/Clock\";\r\n\r\nexport default {\r\n  name: \"收费\",\r\n  data() {\r\n    return {\r\n      patient: {\r\n        caseNumber: '',\r\n        realName: '',\r\n        gender: '',\r\n        cardNumber: '',\r\n        deptmentId: '',\r\n        employeeId: '',\r\n        registerLevelId: '',\r\n        settleCategoryId: '',\r\n        isBook: false,\r\n        registerMethod: '',\r\n        registerMoney: '',\r\n        number: '',\r\n        initialAmount: '',\r\n        usedAmount: '',\r\n        receivableAmount: '',\r\n        visitState: ''\r\n      },\r\n      payPatient: {\r\n        caseNumber: '',\r\n      },\r\n      patientList: [],\r\n      priceList: [],\r\n    }\r\n  },\r\n  methods: {\r\n    reset() {\r\n\r\n    },\r\n    exactSelect() {\r\n      // 根据病历号或者身份证号进行查询病人信息\r\n      if (this.patient.caseNumber !== '') {\r\n        this.$request.post('/register/selectByCaseNumber', this.patient).then(res => {\r\n          if (res.code === '200') {\r\n            this.patientList = res.data\r\n            this.$message.success('查询成功')\r\n          } else {\r\n            this.$message.error(res.msg)\r\n          }\r\n        })\r\n      } else if (this.patient.cardNumber !== '') {\r\n        this.$request.post('/register/selectByCardNumber', this.patient).then(res => {\r\n          if (res.code === '200') {\r\n            this.patientList = res.data\r\n            this.$message.success('查询成功')\r\n          } else {\r\n            this.$message.error(res.msg)\r\n          }\r\n        })\r\n      } else {\r\n        this.$message.error('请输入病历号或者身份证号')\r\n      }\r\n    },\r\n    pay() {\r\n      // 当选择完之后，再进行收费\r\n      this.$request.post('/register/pay', this.payPatient).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('收费成功')\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    selectPriceList(index, row) {\r\n      // 当点击收费的时候，就进行展示该病人都用了的项目\r\n      this.$request.post('/medical-technology/selectPriceList', row).then(res => {\r\n        if (res.code === '200') {\r\n          this.priceList = res.data\r\n          this.payPatient.caseNumber = row.caseNumber\r\n          this.$message.success('查询成功')\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    handleDelete() {\r\n      alert(\"删除\")\r\n    }\r\n  },\r\n  created() {\r\n  },\r\n  components: {\r\n    Clock\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AA+JA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;QACAC,UAAA;QACAC,QAAA;QACAC,MAAA;QACAC,UAAA;QACAC,UAAA;QACAC,UAAA;QACAC,eAAA;QACAC,gBAAA;QACAC,MAAA;QACAC,cAAA;QACAC,aAAA;QACAC,MAAA;QACAC,aAAA;QACAC,UAAA;QACAC,gBAAA;QACAC,UAAA;MACA;MACAC,U