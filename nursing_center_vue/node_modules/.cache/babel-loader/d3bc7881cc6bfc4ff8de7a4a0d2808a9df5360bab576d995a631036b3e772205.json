">\r\n      <el-table\r\n          :data=\"registerList\"\r\n          style=\"width: 100%\"\r\n      >\r\n        <el-table-column label=\"病历号\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.caseNumber }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"姓名\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <el-popover effect=\"light\" trigger=\"hover\" placement=\"top\" width=\"auto\">\r\n              <template #default>\r\n                <div>身份证号: {{ scope.row.cardNumber }}</div>\r\n                <div>住址: {{ scope.row.address }}</div>\r\n                <div>年龄: {{ scope.row.age }}</div>\r\n              </template>\r\n              <template #reference>\r\n                <el-tag>{{ scope.row.realName }}</el-tag>\r\n              </template>\r\n            </el-popover>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"挂号科室\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.caseNumber }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"状态\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span v-if=\"scope.row.visitState === '1'\" style=\"margin-left: 10px\">未看诊</span>\r\n              <span v-if=\"scope.row.visitState === '2'\" style=\"margin-left: 10px\">医生接诊</span>\r\n              <span v-if=\"scope.row.visitState === '3'\" style=\"margin-left: 10px\">看诊完毕</span>\r\n              <span v-if=\"scope.row.visitState === '4'\" style=\"margin-left: 10px\">退号</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column align=\"right\">\r\n          <template #header>\r\n          </template>\r\n          <template #default=\"scope\">\r\n            <el-button size=\"small\" @click=\"handleEdit(scope.$index, scope.row)\">\r\n              编辑\r\n            </el-button>\r\n            <el-button\r\n                size=\"small\"\r\n                type=\"danger\"\r\n                @click=\"handleDelete(scope.$index, scope.row)\"\r\n            >\r\n              退号\r\n            </el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n<script>\r\nimport Clock from \"../../components/Clock\";\r\nexport default {\r\n  name: \"退号\",\r\n  data() {\r\n    return {\r\n      formInline: {\r\n        caseNumber: '',\r\n        realName: '',\r\n        gender: '',\r\n        cardNumber: '',\r\n        birthDate: '',\r\n        age: '',\r\n        address: '',\r\n        visitDate: '',\r\n        noon: '',\r\n        deptmentId: '',\r\n        employeeId: '',\r\n        registerLevelId: '',\r\n        settleCategoryId: '',\r\n        isBook: false,\r\n        registerMethod: '',\r\n        registerMoney: '',\r\n        number: '',\r\n        initialAmount: '',\r\n        usedAmount: '',\r\n        receivableAmount: '',\r\n        visitState: ''\r\n      },\r\n      registerList: []\r\n    }\r\n  },\r\n  methods: {\r\n    exactSelect() {\r\n      if (this.formInline.cardNumber==='' || this.formInline.caseNumber===''){\r\n\r\n      }\r\n\r\n    },\r\n    bulkSelect() {\r\n      alert(\"查询\")\r\n    },\r\n    handleEdit() {\r\n      alert(\"编辑\")\r\n    },\r\n    handleDelete(index, row) {\r\n      this.$confirm('您确定退号吗？', '确认退号', {type: \"warning\"}).then(response => {\r\n        this.$request.delete('/register/delete/' + row.id).then(res => {\r\n          if (res.code === '200') {   // 表示操作成功\r\n            this.$message.success('退号成功！')\r\n            this.$router.go(0)\r\n          } else {\r\n            this.$message.error(res.msg)  // 弹出错误的信息\r\n          }\r\n        })\r\n      }).catch(() => {\r\n        this.$message.info('已取消')\r\n      })\r\n    }\r\n  },\r\n  created() {\r\n    this.$request.get('/register/getAll').then(res => {\r\n      if (res.code === '200') {\r\n        this.registerList = res.data\r\n        console.log(res.data)\r\n      } else {\r\n        this.$message.error(res.msg)\r\n      }\r\n    })\r\n  },\r\n  components: {\r\n    Clock\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AAgHA,OAAAA,KAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;QACAC,UAAA;QACAC,QAAA;QACAC,MAAA;QACAC,UAAA;QACAC,SAAA;QACAC,GAAA;QACAC,OAAA;QACAC,SAAA;QACAC,IAAA;QACAC,UAAA;QACAC,UAAA;QACAC,eAAA;QACAC,gBAAA;QACAC,MAAA;QACAC,cAAA;QACAC,aAAA;QACAC,MAAA;QACAC,aAAA;QACAC,UAAA;QACAC,gBAAA;QACAC,UAAA;MACA;MACAC,YAAA;IACA;EACA;EACAC,OAAA;IACAC,YAAA;MACA,SAAAxB,UAAA,CAAAI,UAAA,gBAAAJ,UAAA,CAAAC,UAAA,UAEA;IAEA;IACAwB,WAAA;MACAC,KAAA;IACA;IACAC,WAAA;MACAD,KAAA;IACA;IACAE,aAAAC,KAAA,EAAAC,GAAA;MACA,KAAAC,QAAA;QAAAC,IAAA;MAAA,GAAAC,IAAA,CAAAC,QAAA;QACA,KAAAC,QAAA,CAAAC,MAAA,uBAAAN,GAAA,CAAAO,EAAA,EAAAJ,IAAA,CAAAK,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YAAA;YACA,KAAAC,QAAA,CAAAC,OAAA;YACA,KAAAC,OAAA,CAAAC,EAAA;UACA;YACA,KAAAH,QAAA,CAAAI,KAAA,CAAAN,GAAA,CAAAO,GAAA;UACA;QACA;MACA,GAAAC,KAAA;QACA,KAAAN,QAAA,CAAAO,IAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAb,QAAA,CAAAc,GAAA,qBAAAhB,IAAA,CAAAK,GAAA;MACA,IAAAA,GAAA,CAAAC,IAAA;QACA,KAAAjB,YAAA,GAAAgB,GAAA,CAAAvC,IAAA;QACAmD,OAAA,CAAAC,GAAA,CAAAb,GAAA,CAAAvC,IAAA;MACA;QACA,KAAAyC,QAAA,CAAAI,KAAA,CAAAN,GAAA,CAAAO,GAAA;MACA;IACA;EACA;EACAO,UAAA;IACAvD;EACA;AACA"},"metadata":{},"sourceType":"module