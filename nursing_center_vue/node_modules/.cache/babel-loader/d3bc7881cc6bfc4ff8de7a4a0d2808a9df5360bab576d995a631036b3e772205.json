{"ast":null,"code":"import Clock from \"../../components/Clock\";\nexport default {\n  name: \"退号\",\n  data() {\n    return {\n      formInline: {\n        caseNumber: '',\n        realName: '',\n        gender: '',\n        cardNumber: '',\n        birthDate: '',\n        age: '',\n        address: '',\n        visitDate: '',\n        noon: '',\n        deptmentId: '',\n        employeeId: '',\n        registerLevelId: '',\n        settleCategoryId: '',\n        isBook: false,\n        registerMethod: '',\n        registerMoney: '',\n        number: '',\n        initialAmount: '',\n        usedAmount: '',\n        receivableAmount: '',\n        visitState: ''\n      },\n      registerList: []\n    };\n  },\n  methods: {\n    exactSelect() {\n      if (this.formInline.cardNumber === '' || this.formInline.caseNumber === '') {}\n    },\n    bulkSelect() {\n      alert(\"查询\");\n    },\n    handleEdit() {\n      alert(\"编辑\");\n    },\n    handleDelete(index, row) {\n      this.$confirm('您确定退号吗？', '确认退号', {\n        type: \"warning\"\n      }).then(response => {\n        this.$request.delete('/register/delete/' + row.id).then(res => {\n          if (res.code === '200') {\n            // 表示操作成功\n            this.$message.success('退号成功！');\n            this.$router.go(0);\n          } else {\n            this.$message.error(res.msg); // 弹出错误的信息\n          }\n        });\n      }).catch(() => {\n        this.$message.info('已取消');\n      });\n    }\n  },\n  created() {\n    this.$request.get('/register/getAll').then(res => {\n      if (res.code === '200') {\n        this.registerList = res.data;\n        console.log(res.data);\n      } else {\n        this.$message.error(res.msg);\n      }\n    });\n  },\n  components: {\n    Clock\n  }\n};","map":{"version":3,"names":["Clock","name","data","formInline","caseNumber","realName","gender","cardNumber","birthDate","age","address","visitDate","noon","deptmentId","employeeId","registerLevelId","settleCategoryId","isBook","regis