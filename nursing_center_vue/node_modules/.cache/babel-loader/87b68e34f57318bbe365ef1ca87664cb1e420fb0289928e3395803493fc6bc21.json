{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"Login\",\n  data() {\n    return {\n      form: {\n        realname: '111',\n        password: '111'\n      }\n    };\n  },\n  created() {},\n  methods: {\n    login() {\n      this.$request.post('/web/login', this.form).then(res => {\n        if (res.code === '200') {\n          this.$message.success('登录成功,正在跳转');\n          this.$router.push('/'); // 跳转主页\n          localStorage.setItem('user', JSON.stringify(res.data));\n          console.log(JSON.parse(localStorage.getItem('user')));\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","form","realname","password","created","methods","login","$request","post","then","res","code","$message","success","$router","push","localStorage","setItem","JSON","stringify","console","log","parse","getItem","error","msg"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\r\n  <div class=\"container\">\r\n    <div style=\"width: 400px; padding: 30px; background-color: white; border-radius: 5px;\">\r\n      <div style=\"text-align: center; font-size: 20px; margin-bottom: 20px; color: #333\">欢迎使用东软云医院</div>\r\n      <el-form :model=\"form\" ref=\"formRef\">\r\n        <el-form-item prop=\"realname\">\r\n          <el-input prefix-icon=\"el-icon-user\" placeholder=\"请输入账号\" v-model=\"form.realname\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item prop=\"password\">\r\n          <el-input prefix-icon=\"el-icon-lock\" placeholder=\"请输入密码\" show-password\r\n                    v-model=\"form.password\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button style=\"width: 100%; background-color: #333; border-color: #333; color: white\" @click=\"login\">\r\n            登录\r\n          </el-button>\r\n        </el-form-item>\r\n        <div style=\"display: flex; align-items: center\">\r\n          <div style=\"flex: 1\"></div>\r\n          <div style=\"flex: 1; text-align: right\">\r\n            还没有账号？请 <a href=\"/register\">注册</a>\r\n          </div>\r\n        </div>\r\n      </el-form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Login\",\r\n  data() {\r\n    return {\r\n      form: {\r\n        realname: '111',\r\n        password: '111'\r\n      }\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  methods: {\r\n    login() {\r\n      this.$request.post('/web/login', this.form).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('登录成功,正在跳转')\r\n          this.$router.push('/')  // 跳转主页\r\n          localStorage.setItem('user', JSON.stringify(res.data));\r\n          console.log(JSON.parse(localStorage.getItem('user')))\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.container {\r\n  height: 100vh;\r\n  overflow: hidden;\r\n  background-image: url(\"@/assets/imgs/bg.jpg\");\r\n  background-size: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #666;\r\n}\r\n\r\na {\r\n  color: #2a60c9;\r\n}\r\n</style>"],"mappings":";AA6BA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;QACAC,QAAA;QACAC,QAAA;MACA;IACA;EACA;EACAC,QAAA,GAEA;EACAC,OAAA;IACAC,MAAA;MACA,KAAAC,QAAA,CAAAC,IAAA,oBAAAP,IAAA,EAAAQ,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAC,OAAA,CAAAC,IAAA;UACAC,YAAA,CAAAC,OAAA,SAAAC,IAAA,CAAAC,SAAA,CAAAT,GAAA,CAAAV,IAAA;UACAoB,OAAA,CAAAC,GAAA,CAAAH,IAAA,CAAAI,KAAA,CAAAN,YAAA,CAAAO,OAAA;QACA;UACA,KAAAX,QAAA,CAAAY,KAAA,CAAAd,GAAA,CAAAe,GAAA;QACA;MACA;IAEA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}