{"ast":null,"code":"import Clock from \"../../components/Clock\";\nexport default {\n  name: \"收费\",\n  data() {\n    return {\n      formInline: {\n        caseNumber: '',\n        realName: '',\n        gender: '',\n        cardNumber: '',\n        birthDate: '',\n        age: '',\n        address: '',\n        visitDate: '',\n        noon: '',\n        deptmentId: '',\n        employeeId: '',\n        registerLevelId: '',\n        settleCategoryId: '',\n        isBook: false,\n        registerMethod: '',\n        registerMoney: '',\n        number: '',\n        initialAmount: '',\n        usedAmount: '',\n        receivableAmount: '',\n        visitState: ''\n      },\n      registerList: []\n    };\n  },\n  methods: {\n    exactSelect() {\n      alert(\"查询\");\n    },\n    bulkSelect() {\n      alert(\"查询\");\n    },\n    handleEdit() {\n      alert(\"编辑\");\n    },\n    handleDelete() {\n      alert(\"删除\");\n    }\n  },\n  created() {},\n  components: {\n    Clock\n  }\n};","map":{"version":3,"names":["Clock","name","data","formInline","caseNumber","realName","gender","cardNumber","birthDate","age","address","visitDate","noon","deptmentId","employeeId","registerLevelId","settleCategoryId","isBook","registerMethod","registerMoney","number","initialAmount","usedAmount","receivableAmount","visitState","registerList","methods","exactSelect","alert","bulkSelect","handleEdit","handleDelete","created","components"],"sources":["src/views/manager/Toll.vue"],"sourcesContent":["<template xmlns=\"http://www.w3.org/1999/html\">\r\n  <div>\r\n    <el-card>\r\n      <h2>收费</h2>\r\n      <br>\r\n      <hr>\r\n      <br>\r\n      <Clock/>\r\n      <br>\r\n    </el-card>\r\n    <el-card style=\"margin-top: 10px\">\r\n      <span style=\"font-size: 17px\">患者选择</span>\r\n      <div style=\"margin-top: 10px\">\r\n        <el-form :inline=\"true\" :model=\"formInline\" class=\"demo-form-inline\">\r\n          <el-form-item label=\"病历号:\">\r\n            <el-input v-model=\"formInline.caseNumber\" placeholder=\"病历号\" clearable/>\r\n          </el-form-item>\r\n          <el-form-item label=\"身份证号:\">\r\n            <el-input v-model=\"formInline.cardNumber\" placeholder=\"身份证号\" clearable/>\r\n          </el-form-item>\r\n          <el-button type=\"primary\" @click=\"exactSelect\">查询</el-button>\r\n        </el-form>\r\n      </div>\r\n      <span style=\"font-size: 17px\">患者信息</span>\r\n\r\n      <div style=\"margin-top: 10px\">\r\n\r\n      </div>\r\n    </el-card>\r\n    <el-card style=\"margin-top: 10px\">\r\n      <el-table\r\n          :data=\"registerList\"\r\n          style=\"width: 100%\"\r\n      >\r\n        <el-table-column label=\"病历号\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.caseNumber }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"姓名\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <el-popover effect=\"light\" trigger=\"hover\" placement=\"top\" width=\"auto\">\r\n              <template #default>\r\n                <div>身份证号: {{ scope.row.cardNumber }}</div>\r\n                <div>住址: {{ scope.row.address }}</div>\r\n                <div>年龄: {{ scope.row.age }}</div>\r\n              </template>\r\n              <template #reference>\r\n                <el-tag>{{ scope.row.realName }}</el-tag>\r\n              </template>\r\n            </el-popover>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"挂号科室\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.caseNumber }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"是否已看诊过？\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span v-if=\"scope.row.visitState === '0'\" style=\"margin-left: 10px\">未看诊</span>\r\n              <span v-if=\"scope.row.visitState !== '0'\" style=\"margin-left: 10px\">已看诊</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"总费用：\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span v-if=\"scope.row.visitState === '0'\" style=\"margin-left: 10px\">未看诊</span>\r\n              <span v-if=\"scope.row.visitState !== '0'\" style=\"margin-left: 10px\">已看诊</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column align=\"right\">\r\n          <template #header>\r\n\r\n          </template>\r\n          <template #default=\"scope\">\r\n            <el-button size=\"small\" @click=\"handleEdit(scope.$index, scope.row)\">\r\n              编辑\r\n            </el-button>\r\n            <el-button\r\n                size=\"small\"\r\n                type=\"danger\"\r\n                @click=\"handleDelete(scope.$index, scope.row)\"\r\n            >\r\n              退号\r\n            </el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n<script>\r\nimport Clock from \"../../components/Clock\";\r\n\r\nexport default {\r\n  name: \"收费\",\r\n  data() {\r\n    return {\r\n      formInline: {\r\n        caseNumber: '',\r\n        realName: '',\r\n        gender: '',\r\n        cardNumber: '',\r\n        birthDate: '',\r\n        age: '',\r\n        address: '',\r\n        visitDate: '',\r\n        noon: '',\r\n        deptmentId: '',\r\n        employeeId: '',\r\n        registerLevelId: '',\r\n        settleCategoryId: '',\r\n        isBook: false,\r\n        registerMethod: '',\r\n        registerMoney: '',\r\n        number: '',\r\n        initialAmount: '',\r\n        usedAmount: '',\r\n        receivableAmount: '',\r\n        visitState: ''\r\n      },\r\n      registerList: []\r\n    }\r\n  },\r\n  methods: {\r\n    exactSelect() {\r\n      alert(\"查询\")\r\n    },\r\n    bulkSelect() {\r\n      alert(\"查询\")\r\n    },\r\n    handleEdit() {\r\n      alert(\"编辑\")\r\n    },\r\n    handleDelete() {\r\n      alert(\"删除\")\r\n    }\r\n  },\r\n  created() {\r\n  },\r\n  components: {\r\n    Clock\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AAkHA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;QACAC,UAAA;QACAC,QAAA;QACAC,MAAA;QACAC,UAAA;QACAC,SAAA;QACAC,GAAA;QACAC,OAAA;QACAC,SAAA;QACAC,IAAA;QACAC,UAAA;QACAC,UAAA;QACAC,eAAA;QACAC,gBAAA;QACAC,MAAA;QACAC,cAAA;QACAC,aAAA;QACAC,MAAA;QACAC,aAAA;QACAC,UAAA;QACAC,gBAAA;QACAC,UAAA;MACA;MACAC,YAAA;IACA;EACA;EACAC,OAAA;IACAC,YAAA;MACAC,KAAA;IACA;IACAC,WAAA;MACAD,KAAA;IACA;IACAE,WAAA;MACAF,KAAA;IACA;IACAG,aAAA;MACAH,KAAA;IACA;EACA;EACAI,QAAA,GACA;EACAC,UAAA;IACAjC;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}