{"ast":null,"code":"export default {\n  name: \"Registered\",\n  data() {\n    return {\n      employee: {\n        employeeId: '',\n        realName: ''\n      },\n      formInline: {\n        // 病历号\n        caseNumber: '',\n        // 真实姓名\n        realName: '',\n        // 性别\n        gender: '',\n        // 身份证号\n        cardNumber: '',\n        // 出生日期\n        birthdate: '',\n        // 年龄\n        age: '',\n        // 家庭住址\n        homeAddress: '',\n        // 就诊日期\n        visitDate: '',\n        // 午别\n        noon: '',\n        // 挂号科室id\n        deptmentId: '',\n        // 看诊医生\n        employeeId: '',\n        // 挂号级别\n        registerLevelId: '0',\n        // 结算类型\n        settleCategoryId: '',\n        // 是否需要病历本\n        isBook: false,\n        // 收费方式\n        registerMethod: '',\n        // 挂号金额\n        registerMoney: '',\n        // 号别\n        number: '',\n        // // 初始金额\n        // initialAmount: '',\n\n        // 已用号额\n        usedAmount: 10,\n        // 挂号状态\n        visitState: 1\n      },\n      deptmentList: [],\n      employeeList: [{\n        employeeId: '0',\n        realName: '王小明'\n      }, {\n        employeeId: '1',\n        realName: '王小红'\n      }]\n    };\n  },\n  methods: {\n    reset() {\n      this.formInline.caseNumber = '';\n      this.formInline.realName = '';\n      this.formInline.gender = '';\n      this.formInline.cardNumber = '';\n      this.formInline.birthDate = '';\n      this.formInline.age = '';\n      this.formInline.address = '';\n      this.formInline.visitDate = '';\n      this.formInline.noon = '';\n      this.formInline.deptmentId = '';\n      this.formInline.employeeId = '';\n      this.formInline.registerLevelId = '';\n      this.formInline.settleCategoryId = '';\n      this.formInline.isBook = false;\n      this.formInline.registerMethod = '';\n      this.formInline.registerMoney = '';\n      this.formInline.number = '';\n      this.formInline.initialAmount = '';\n      this.formInline.usedAmount = '';\n      this.formInline.receivableAmount = '';\n      this.formInline.visitState = '';\n    },\n    judgement() {\n      if (this.formInline.birthdate === '') {\n        this.$message.error('请输入出生日期');\n        return false;\n      }\n      return true;\n    },\n    add() {\n      // 计算年龄\n      if (!this.judgement()) {\n        return;\n      }\n      this.formInline.age = new Date().getFullYear() - this.formInline.birthdate.getFullYear();\n      // 判断是否满足条件\n\n      //   发送请求\n      this.$request.post('/register/add', this.formInline).then(res => {\n        if (res.code === '200') {\n          this.$message.success('挂号成功');\n          this.reset();\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    onSubmit() {\n      console.log(\"submit!\");\n    }\n  },\n  created() {\n    this.$request.get('/department/getAll', {}).then(res => {\n      this.deptmentList = res.data;\n      console.log(res.data);\n    });\n    this.$request.get('/employee/getAll', {}).then(res => {\n      this.employeeList = res.data;\n    });\n  }\n};","map":{"version":3,"names":["name","data","employee","employeeId","realName","formInline","caseNumber","gender","cardNumber","birthdate","age","homeAddress","visitDate","noon","deptmentId","registerLevelId","settleCategoryId","isBook","registerMethod","registerMoney","number","usedAmount","visitState","deptmentList","employeeList","methods","reset","birthDate","address","initialAmount","receivableAmount","judgement","$message","error","add","Date","getFullYear","$request","post","then","res","code","success","msg","onSubmit","console","log","created","get"],"sources":["src/views/manager/Registered.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-card>\r\n      <h2>现场挂号</h2>\r\n      <br>\r\n      <hr>\r\n      <br>\r\n      <!--      <h3 style=\"margin-bottom: 10px\">你好! {{ employee.realName || \"医生\"}} 你当前已用号额: {{ formInline.usedAmount }}个</h3>-->\r\n      <el-button type=\"primary\" @click=\"add\">挂号</el-button>\r\n      <el-button type=\"info\" @click=\"reset\">重置</el-button>\r\n    </el-card>\r\n    <el-card style=\"margin-top: 10px\">\r\n      <div slot=\"header\" class=\"clearfix\">\r\n        <span style=\"font-size: 17px\">基本信息</span>\r\n      </div>\r\n      <el-form :inline=\"true\" :model=\"formInline\" class=\"demo-form-inline\">\r\n        <el-form-item label=\"病历号:\">\r\n          <el-input v-model=\"formInline.caseNumber\" placeholder=\"病历号\" clearable/>\r\n        </el-form-item>\r\n        <el-form-item label=\"姓名:\">\r\n          <el-input v-model=\"formInline.realName\" placeholder=\"姓名\" clearable/>\r\n        </el-form-item>\r\n        <el-form-item label=\"性别:\">\r\n          <el-select\r\n              v-model=\"formInline.gender\"\r\n              placeholder=\"性别\"\r\n              clearable\r\n          >\r\n            <el-option label=\"男\" value=\"男\"/>\r\n            <el-option label=\"女\" value=\"女\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"出生日期:\">\r\n          <el-date-picker\r\n              v-model=\"formInline.birthdate\"\r\n              type=\"date\"\r\n              placeholder=\"出生日期\"\r\n              clearable\r\n          />\r\n        </el-form-item>\r\n        <el-form-item label=\"家庭住址:\">\r\n          <el-input v-model=\"formInline.homeAddress\" placeholder=\"家庭住址\" clearable/>\r\n        </el-form-item>\r\n        <el-form-item label=\"身份证号:\">\r\n          <el-input v-model=\"formInline.cardNumber\" placeholder=\"身份证号\" clearable/>\r\n        </el-form-item>\r\n      </el-form>\r\n    </el-card>\r\n    <el-card style=\"margin-top: 10px\">\r\n      <div slot=\"header\" class=\"clearfix\">\r\n        <span style=\"font-size: 17px\">挂号信息</span>\r\n      </div>\r\n      <el-form :inline=\"true\" :model=\"formInline\" class=\"demo-form-inline\">\r\n\r\n        <el-form-item label=\"结算类型:\">\r\n          <el-select\r\n              v-model=\"formInline.settleCategoryId\"\r\n              placeholder=\"医保或者自费\"\r\n              clearable\r\n          >\r\n            <el-option label=\"自费\" value=\"0\"/>\r\n            <el-option label=\"医保\" value=\"1\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"看诊日期:\">\r\n          <el-date-picker\r\n              v-model=\"formInline.visitDate\"\r\n              type=\"date\"\r\n              placeholder=\"选择看诊日期\"\r\n              clearable\r\n          />\r\n        </el-form-item>\r\n        <el-form-item label=\"午别:\">\r\n          <el-select\r\n              v-model=\"formInline.noon\"\r\n              placeholder=\"00:00-12.00 上午 12.01-23.59 下午\"\r\n              clearable\r\n          >\r\n            <el-option label=\"上午\" value=\"0\"/>\r\n            <el-option label=\"下午\" value=\"1\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"挂号科室:\">\r\n          <el-select\r\n              v-model=\"formInline.deptmentId\"\r\n              placeholder=\"挂号科室\"\r\n              clearable\r\n          >\r\n            <el-option v-for=\"item in deptmentList\" :key=\"item.id\" :label=\"item.deptName\"\r\n                       :value=\"item.id\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"号别:\">\r\n          <el-select\r\n              v-model=\"formInline.number\"\r\n              placeholder=\"号别\"\r\n              clearable\r\n          >\r\n            <el-option label=\"1\" value=\"1\"/>\r\n            <el-option label=\"2\" value=\"2\"/>\r\n            <el-option label=\"2\" value=\"2\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"看诊医生:\">\r\n          <el-select\r\n              v-model=\"formInline.employeeId\"\r\n              placeholder=\"看诊医生\"\r\n              clearable\r\n          >\r\n            <el-option v-for=\"item in employeeList\" :key=\"item.employeeId\" :label=\"item.realName\"\r\n                       :value=\"item.employeeId\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"应收金额:\">\r\n          <el-input v-model=\"formInline.registerMoney\" placeholder=\"应收金额\" clearable/>\r\n        </el-form-item>\r\n        <br>\r\n        <el-form-item label=\"是否需要病历本？\" prop=\"sing\">\r\n          <el-switch v-model=\"formInline.isBook\"/>\r\n        </el-form-item>\r\n        <el-form-item label=\"结算方式:\" v-if=\"formInline.settleCategoryId==='0'\">\r\n          <el-select\r\n              v-model=\"formInline.registerMethod\"\r\n              placeholder=\"选择结算类型\"\r\n              clearable\r\n          >\r\n            <el-option label=\"现金\" value=\"1\"/>\r\n            <el-option label=\"微信\" value=\"2\"/>\r\n            <el-option label=\"支付宝\" value=\"3\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n      </el-form>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: \"Registered\",\r\n  data() {\r\n    return {\r\n      employee: {\r\n        employeeId: '',\r\n        realName: '',\r\n      },\r\n      formInline: {\r\n        // 病历号\r\n        caseNumber: '',\r\n\r\n        // 真实姓名\r\n        realName: '',\r\n\r\n        // 性别\r\n        gender: '',\r\n\r\n        // 身份证号\r\n        cardNumber: '',\r\n\r\n        // 出生日期\r\n        birthdate: '',\r\n\r\n        // 年龄\r\n        age: '',\r\n\r\n        // 家庭住址\r\n        homeAddress: '',\r\n\r\n        // 就诊日期\r\n        visitDate: '',\r\n\r\n        // 午别\r\n        noon: '',\r\n\r\n        // 挂号科室id\r\n        deptmentId: '',\r\n\r\n        // 看诊医生\r\n        employeeId: '',\r\n\r\n        // 挂号级别\r\n        registerLevelId: '0',\r\n\r\n        // 结算类型\r\n        settleCategoryId: '',\r\n\r\n        // 是否需要病历本\r\n        isBook: false,\r\n\r\n        // 收费方式\r\n        registerMethod: '',\r\n\r\n        // 挂号金额\r\n        registerMoney: '',\r\n\r\n        // 号别\r\n        number: '',\r\n\r\n        // // 初始金额\r\n        // initialAmount: '',\r\n\r\n        // 已用号额\r\n        usedAmount: 10,\r\n\r\n\r\n        // 挂号状态\r\n        visitState: 1,\r\n      },\r\n      deptmentList: [],\r\n      employeeList: [\r\n        {\r\n          employeeId: '0',\r\n          realName: '王小明'\r\n        },\r\n        {\r\n          employeeId: '1',\r\n          realName: '王小红'\r\n        }\r\n      ],\r\n    };\r\n  },\r\n  methods: {\r\n    reset() {\r\n      this.formInline.caseNumber = ''\r\n      this.formInline.realName = ''\r\n      this.formInline.gender = ''\r\n      this.formInline.cardNumber = ''\r\n      this.formInline.birthDate = ''\r\n      this.formInline.age = ''\r\n      this.formInline.address = ''\r\n      this.formInline.visitDate = ''\r\n      this.formInline.noon = ''\r\n      this.formInline.deptmentId = ''\r\n      this.formInline.employeeId = ''\r\n      this.formInline.registerLevelId = ''\r\n      this.formInline.settleCategoryId = ''\r\n      this.formInline.isBook = false\r\n      this.formInline.registerMethod = ''\r\n      this.formInline.registerMoney = ''\r\n      this.formInline.number = ''\r\n      this.formInline.initialAmount = ''\r\n      this.formInline.usedAmount = ''\r\n      this.formInline.receivableAmount = ''\r\n      this.formInline.visitState = ''\r\n    },\r\n    judgement() {\r\n      if (this.formInline.birthdate === '') {\r\n        this.$message.error('请输入出生日期')\r\n        return false\r\n      }\r\n\r\n      return true\r\n    },\r\n    add() {\r\n      // 计算年龄\r\n      if (!this.judgement()) {\r\n        return\r\n      }\r\n      this.formInline.age = new Date().getFullYear() - this.formInline.birthdate.getFullYear()\r\n      // 判断是否满足条件\r\n\r\n      //   发送请求\r\n      this.$request.post('/register/add', this.formInline).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('挂号成功')\r\n          this.reset()\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n\r\n    onSubmit() {\r\n      console.log(\"submit!\");\r\n    },\r\n  },\r\n  created() {\r\n    this.$request.get('/department/getAll', {\r\n    }).then(res => {\r\n      this.deptmentList = res.data\r\n      console.log(res.data)\r\n    })\r\n    this.$request.get('/employee/getAll', {\r\n    }).then(res => {\r\n      this.employeeList = res.data\r\n    })\r\n  }\r\n};\r\n</script>\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AAwIA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;QACAC,UAAA;QACAC,QAAA;MACA;MACAC,UAAA;QACA;QACAC,UAAA;QAEA;QACAF,QAAA;QAEA;QACAG,MAAA;QAEA;QACAC,UAAA;QAEA;QACAC,SAAA;QAEA;QACAC,GAAA;QAEA;QACAC,WAAA;QAEA;QACAC,SAAA;QAEA;QACAC,IAAA;QAEA;QACAC,UAAA;QAEA;QACAX,UAAA;QAEA;QACAY,eAAA;QAEA;QACAC,gBAAA;QAEA;QACAC,MAAA;QAEA;QACAC,cAAA;QAEA;QACAC,aAAA;QAEA;QACAC,MAAA;QAEA;QACA;;QAEA;QACAC,UAAA;QAGA;QACAC,UAAA;MACA;MACAC,YAAA;MACAC,YAAA,GACA;QACArB,UAAA;QACAC,QAAA;MACA,GACA;QACAD,UAAA;QACAC,QAAA;MACA;IAEA;EACA;EACAqB,OAAA;IACAC,MAAA;MACA,KAAArB,UAAA,CAAAC,UAAA;MACA,KAAAD,UAAA,CAAAD,QAAA;MACA,KAAAC,UAAA,CAAAE,MAAA;MACA,KAAAF,UAAA,CAAAG,UAAA;MACA,KAAAH,UAAA,CAAAsB,SAAA;MACA,KAAAtB,UAAA,CAAAK,GAAA;MACA,KAAAL,UAAA,CAAAuB,OAAA;MACA,KAAAvB,UAAA,CAAAO,SAAA;MACA,KAAAP,UAAA,CAAAQ,IAAA;MACA,KAAAR,UAAA,CAAAS,UAAA;MACA,KAAAT,UAAA,CAAAF,UAAA;MACA,KAAAE,UAAA,CAAAU,eAAA;MACA,KAAAV,UAAA,CAAAW,gBAAA;MACA,KAAAX,UAAA,CAAAY,MAAA;MACA,KAAAZ,UAAA,CAAAa,cAAA;MACA,KAAAb,UAAA,CAAAc,aAAA;MACA,KAAAd,UAAA,CAAAe,MAAA;MACA,KAAAf,UAAA,CAAAwB,aAAA;MACA,KAAAxB,UAAA,CAAAgB,UAAA;MACA,KAAAhB,UAAA,CAAAyB,gBAAA;MACA,KAAAzB,UAAA,CAAAiB,UAAA;IACA;IACAS,UAAA;MACA,SAAA1B,UAAA,CAAAI,SAAA;QACA,KAAAuB,QAAA,CAAAC,KAAA;QACA;MACA;MAEA;IACA;IACAC,IAAA;MACA;MACA,UAAAH,SAAA;QACA;MACA;MACA,KAAA1B,UAAA,CAAAK,GAAA,OAAAyB,IAAA,GAAAC,WAAA,UAAA/B,UAAA,CAAAI,SAAA,CAAA2B,WAAA;MACA;;MAEA;MACA,KAAAC,QAAA,CAAAC,IAAA,uBAAAjC,UAAA,EAAAkC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAT,QAAA,CAAAU,OAAA;UACA,KAAAhB,KAAA;QACA;UACA,KAAAM,QAAA,CAAAC,KAAA,CAAAO,GAAA,CAAAG,GAAA;QACA;MACA;IACA;IAEAC,SAAA;MACAC,OAAA,CAAAC,GAAA