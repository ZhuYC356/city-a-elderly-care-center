{"ast":null,"code":"export default {\n  name: \"病案首页\",\n  data() {\n    return {\n      tableData: [{\n        date: '2016-05-03',\n        name: 'Tom',\n        address: 'No. 189, Grove St, Los Angeles'\n      }, {\n        date: '2016-05-02',\n        name: 'Tom',\n        address: 'No. 189, Grove St, Los Angeles'\n      }, {\n        date: '2016-05-04',\n        name: 'Tom',\n        address: 'No. 189, Grove St, Los Angeles'\n      }, {\n        date: '2016-05-01',\n        name: 'Tom',\n        address: 'No. 189, Grove St, Los Angeles'\n      }],\n      form: {\n        name: '',\n        region: '',\n        date1: '',\n        date2: '',\n        delivery: false,\n        type: [],\n        resource: '',\n        desc: '',\n        multipleSelection: []\n      }\n    };\n  },\n  computed: {\n    multipleTable() {\n      return this.$refs.multipleTable;\n    }\n  },\n  methods: {\n    onSubmit() {\n      console.log('submit!');\n    },\n    // handleEdit(index, row) {\n    //   console.log(index, row);\n    // },\n    // handleDelete(index, row) {\n    //   console.log(index, row);\n    // },\n    // handleSelectionChange(User){\n    //   multipleSelection.value = val\n    // }\n    selectable(row) {\n      return ![1, 2].includes(row.id);\n    },\n    toggleSelection(rows, ignoreSelectable) {\n      if (rows) {\n        rows.forEach(row => {\n          this.multipleTable.toggleRowSelection(row, true, ignoreSelectable);\n        });\n      } else {\n        this.multipleTable.clearSelection();\n      }\n    },\n    handleSelectionChange(val) {\n      this.multipleSelection = val;\n    }\n  },\n  created() {},\n  mounted() {}\n};","map":{"version":3,"names":["name","data","tableData","date","address","form","region","date1","date2","delivery","type","resource","desc","multipleSelection","computed","multipleTable","$refs","methods","onSubmit","console","log","selectable","row","includes","id","toggleSelection","rows","ignoreSelectable","forEach","toggleRowSelection","clearSelection","handleSelectionChange","val","created","mounted"],"sources":["src/views/manager/Diagnosis-MedicalRecord.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-form :model=\"form\" label-width=\"auto\" style=\"max-width: 95%\">\r\n      <el-form-item label=\"主诉\">\r\n        <el-input placeholder=\"主诉\" v-model=\"form.name\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"现病史\">\r\n        <el-input placeholder=\"现病史\" v-model=\"form.name\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"现病治疗情况\">\r\n        <el-input placeholder=\"现病治疗情况\" v-model=\"form.name\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"既往史\">\r\n        <el-input placeholder=\"既往史\" v-model=\"form.name\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"过敏史\">\r\n        <el-input placeholder=\"过敏史\" v-model=\"form.name\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"体格检查\">\r\n        <el-input placeholder=\"体格检查\" v-model=\"form.name\"/>\r\n      </el-form-item>\r\n\r\n      <!--    表格-->\r\n      <el-table\r\n          ref=\"multipleTableRef\"\r\n          :data=\"tableData\"\r\n          style=\"width: 100%\"\r\n          @selection-change=\"handleSelectionChange\"\r\n      >\r\n        <el-table-column type=\"selection\" :selectable=\"selectable\" width=\"55\"/>\r\n        <el-table-column label=\"Date\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.date }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"Name\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <el-popover effect=\"light\" trigger=\"hover\" placement=\"top\" width=\"auto\">\r\n              <template #default>\r\n                <div>name: {{ scope.row.name }}</div>\r\n                <div>address: {{ scope.row.address }}</div>\r\n              </template>\r\n              <template #reference>\r\n                <el-tag>{{ scope.row.name }}</el-tag>\r\n              </template>\r\n            </el-popover>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"Operations\">\r\n          <template #default=\"scope\">\r\n            <el-button size=\"small\" @click=\"handleEdit(scope.$index, scope.row)\">\r\n              Edit\r\n            </el-button>\r\n            <el-button\r\n                size=\"small\"\r\n                type=\"danger\"\r\n                @click=\"handleDelete(scope.$index, scope.row)\"\r\n            >\r\n              Delete\r\n            </el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <el-form-item label=\"检查建议\">\r\n        <el-input placeholder=\"检查建议\" v-model=\"form.name\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"注意事项\">\r\n        <el-input placeholder=\"注意事项\" v-model=\"form.name\"/>\r\n      </el-form-item>\r\n      <el-form-item>\r\n        <el-button type=\"primary\" @click=\"onSubmit\">保存</el-button>\r\n        <el-button>首页</el-button>\r\n      </el-form-item>\r\n    </el-form>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: \"病案首页\",\r\n  data() {\r\n    return {\r\n      tableData: [\r\n        {\r\n          date: '2016-05-03',\r\n          name: 'Tom',\r\n          address: 'No. 189, Grove St, Los Angeles',\r\n        },\r\n        {\r\n          date: '2016-05-02',\r\n          name: 'Tom',\r\n          address: 'No. 189, Grove St, Los Angeles',\r\n        },\r\n        {\r\n          date: '2016-05-04',\r\n          name: 'Tom',\r\n          address: 'No. 189, Grove St, Los Angeles',\r\n        },\r\n        {\r\n          date: '2016-05-01',\r\n          name: 'Tom',\r\n          address: 'No. 189, Grove St, Los Angeles',\r\n        },\r\n      ],\r\n      form: {\r\n        name: '',\r\n        region: '',\r\n        date1: '',\r\n        date2: '',\r\n        delivery: false,\r\n        type: [],\r\n        resource: '',\r\n        desc: '',\r\n        multipleSelection: []\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    multipleTable() {\r\n      return this.$refs.multipleTable;\r\n    }\r\n  },\r\n  methods: {\r\n    onSubmit() {\r\n      console.log('submit!');\r\n    },\r\n    // handleEdit(index, row) {\r\n    //   console.log(index, row);\r\n    // },\r\n    // handleDelete(index, row) {\r\n    //   console.log(index, row);\r\n    // },\r\n    // handleSelectionChange(User){\r\n    //   multipleSelection.value = val\r\n    // }\r\n    selectable(row) {\r\n      return ![1, 2].includes(row.id);\r\n    },\r\n    toggleSelection(rows, ignoreSelectable) {\r\n      if (rows) {\r\n        rows.forEach(row => {\r\n          this.multipleTable.toggleRowSelection(\r\n              row,\r\n              true,\r\n              ignoreSelectable\r\n          );\r\n        });\r\n      } else {\r\n        this.multipleTable.clearSelection();\r\n      }\r\n    },\r\n    handleSelectionChange(val) {\r\n      this.multipleSelection = val;\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  mounted() {\r\n\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AAmFA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA,GACA;QACAC,IAAA;QACAH,IAAA;QACAI,OAAA;MACA,GACA;QACAD,IAAA;QACAH,IAAA;QACAI,OAAA;MACA,GACA;QACAD,IAAA;QACAH,IAAA;QACAI,OAAA;MACA,GACA;QACAD,IAAA;QACAH,IAAA;QACAI,OAAA;MACA,EACA;MACAC,IAAA;QACAL,IAAA;QACAM,MAAA;QACAC,KAAA;QACAC,KAAA;QACAC,QAAA;QACAC,IAAA;QACAC,QAAA;QACAC,IAAA;QACAC,iBAAA;MACA;IACA;EACA;EACAC,QAAA;IACAC,cAAA;MACA,YAAAC,KAAA,CAAAD,aAAA;IACA;EACA;EACAE,OAAA;IACAC,SAAA;MACAC,OAAA,CAAAC,GAAA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;IACAC,WAAAC,GAAA;MACA,eAAAC,QAAA,CAAAD,GAAA,CAAAE,EAAA;IACA;IACAC,gBAAAC,IAAA,EAAAC,gBAAA;MACA,IAAAD,IAAA;QACAA,IAAA,CAAAE