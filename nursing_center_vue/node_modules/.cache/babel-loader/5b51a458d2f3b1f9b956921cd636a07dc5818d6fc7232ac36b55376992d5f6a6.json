Method = '';\n      this.formInline.registerMoney = '';\n      this.formInline.number = '';\n      this.formInline.initialAmount = '';\n      this.formInline.usedAmount = '';\n      this.formInline.receivableAmount = '';\n      this.formInline.visitState = '';\n    },\n    add() {\n      // 计算年龄\n      this.formInline.age = new Date().getFullYear() - this.formInline.birthDate.getFullYear();\n      // 判断是否满足条件\n      //   发送请求\n    },\n\n    onSubmit() {\n      console.log(\"submit!\");\n    },\n    created() {\n      //   初始化医生和部门列表\n    }\n  }\n};","map":{"version":3,"names":["name","data","employee","employeeId","realName","formInline","caseNumber","gender","cardNumber","birthDate","age","address","visitDate","noon","deptmentId","registerLevelId","settleCategoryId","isBook","registerMethod","registerMoney","number","usedAmount","receivableAmount","visitState","deptmentList","deptmentName","employeeList","methods","reset","initialAmount","add","Date","getFullYear","onSubmit","console","log","created"],"sources":["src/views/manager/Registered.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-card>\r\n      <h2>现场挂号</h2>\r\n      <br>\r\n      <hr>\r\n      <br>\r\n      <!--      <h3 style=\"margin-bottom: 10px\">你好! {{ employee.realName || \"医生\"}} 你当前已用号额: {{ formInline.usedAmount }}个</h3>-->\r\n      <el-button type=\"primary\" @click=\"add\">挂号</el-button>\r\n      <el-button type=\"info\" @click=\"reset\">重置</el-button>\r\n    </el-card>\r\n    <el-card style=\"margin-top: 10px\">\r\n      <div slot=\"header\" class=\"clearfix\">\r\n        <span style=\"font-size: 17px\">基本信息</span>\r\n      </div>\r\n      <el-form :inline=\"true\" :model=\"formInline\" class=\"demo-form-inline\">\r\n        <el-form-item label=\"病历号:\">\r\n          <el-input v-model=\"formInline.caseNumber\" placeholder=\"病历号\" clearable/>\r\n        </el-form-item>\r\n        <el-form-item label=\"姓名:\">\r\n          <el-input v-model=\"formInline.realName\" placeholder=\"姓名\" clearable/>\r\n        </el-form-item>\r\n        <el-form-item label=\"性别:\">\r\n          <el-select\r\n              v-model=\"formInline.gender\"\r\n              placeholder=\"性别\"\r\n              clearable\r\n          >\r\n            <el-option label=\"男\" value=\"男\"/>\r\n            <el-option label=\"女\" value=\"女\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"出生日期:\">\r\n          <el-date-picker\r\n              v-model=\"formInline.birthDate\"\r\n              type=\"date\"\r\n              placeholder=\"出生日期\"\r\n              clearable\r\n          />\r\n        </el-form-item>\r\n        <el-form-item label=\"家庭住址:\">\r\n          <el-input v-model=\"formInline.address\" placeholder=\"家庭住址\" clearable/>\r\n        </el-form-item>\r\n        <el-form-item label=\"身份证号:\">\r\n          <el-input v-model=\"formInline.cardNumber\" placeholder=\"身份证号\" clearable/>\r\n        </el-form-item>\r\n      </el-form>\r\n    </el-card>\r\n    <el-card style=\"margin-top: 10px\">\r\n      <div slot=\"header\" class=\"clearfix\">\r\n        <span style=\"font-size: 17px\">挂号信息</span>\r\n      </div>\r\n      <el-form :inline=\"true\" :model=\"formInline\" class=\"demo-form-inline\">\r\n        <el-form-item label=\"结算类型:\">\r\n          <el-select\r\n              v-model=\"formInline.settleCategoryId\"\r\n              placeholder=\"选择结算类型\"\r\n              clearable\r\n          >\r\n            <el-option label=\"微信\" value=\"0\"/>\r\n            <el-option label=\"支付宝\" value=\"1\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"看诊日期:\">\r\n          <el-date-picker\r\n              v-model=\"formInline.visitDate\"\r\n              type=\"date\"\r\n              placeholder=\"选择看诊日期\"\r\n              clearable\r\n          />\r\n        </el-form-item>\r\n        <el-form-item label=\"午别:\">\r\n          <el-select\r\n              v-model=\"formInline.noon\"\r\n              placeholder=\"午别\"\r\n              clearable\r\n          >\r\n            <el-option label=\"上午\" value=\"0\"/>\r\n            <el-option label=\"下午\" value=\"1\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"挂号科室:\">\r\n          <el-select\r\n              v-model=\"formInline.deptmentId\"\r\n              placeholder=\"挂号科室\"\r\n              clearable\r\n          >\r\n            <el-option v-for=\"item in deptmentList\" :key=\"item.deptmentId\" :label=\"item.deptmentName\" :value=\"item.deptmentId\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"号别:\">\r\n          <el-select\r\n              v-model=\"formInline.number\"\r\n              placeholder=\"号别\"\r\n              clearable\r\n          >\r\n            <el-option label=\"1\" value=\"1\"/>\r\n            <el-option label=\"2\" value=\"2\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"看诊医生:\">\r\n          <el-select\r\n              v-model=\"formInline.employeeId\"\r\n              placeholder=\"看诊医生\"\r\n              clearable\r\n          >\r\n            <el-option v-for=\"item in employeeList\" :key=\"item.employeeId\" :label=\"item.realName\" :value=\"item.employeeId\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n        <!--        <el-form-item label=\"初始金额:\">-->\r\n        <!--          <el-input v-model=\"formInline.initialAmount\" placeholder=\"初始金额\" clearable/>-->\r\n        <!--        </el-form-item>-->\r\n\r\n        <el-form-item label=\"应收金额:\">\r\n          <el-input v-model=\"formInline.receivableAmount\" placeholder=\"应收金额\" clearable/>\r\n        </el-form-item>\r\n        <br>\r\n        <el-form-item label=\"是否需要病历本？\" prop=\"sing\">\r\n          <el-switch v-model=\"formInline.isBook\"/>\r\n        </el-form-item>\r\n      </el-form>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: \"Registered\",\r\n