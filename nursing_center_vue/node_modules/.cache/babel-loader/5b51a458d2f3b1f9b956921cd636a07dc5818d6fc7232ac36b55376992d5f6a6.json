noon = ''\r\n      this.formInline.deptmentId = ''\r\n      this.formInline.employeeId = ''\r\n      this.formInline.registerLevelId = ''\r\n      this.formInline.settleCategoryId = ''\r\n      this.formInline.isBook = false\r\n      this.formInline.registerMethod = ''\r\n      this.formInline.registerMoney = ''\r\n      this.formInline.number = ''\r\n      this.formInline.initialAmount = ''\r\n      this.formInline.usedAmount = ''\r\n      this.formInline.receivableAmount = ''\r\n      this.formInline.visitState = ''\r\n    },\r\n    add() {\r\n      // 计算年龄\r\n      this.formInline.age = new Date().getFullYear() - this.formInline.birthDate.getFullYear();\r\n      // 判断是否满足条件\r\n      //   发送请求\r\n    },\r\n    onSubmit() {\r\n      console.log(\"submit!\");\r\n    },\r\n    created() {\r\n    //   初始化医生和部门列表\r\n    }\r\n  }\r\n};\r\n</script>\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AA6HA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;QACAC,UAAA;QACAC,QAAA;MACA;MACAC,UAAA;QACA;QACAC,UAAA;QAEA;QACAF,QAAA;QAEA;QACAG,MAAA;QAEA;QACAC,UAAA;QAEA;QACAC,SAAA;QAEA;QACAC,GAAA;QAEA;QACAC,OAAA;QAEA;QACAC,SAAA;QAEA;QACAC,IAAA;QAEA;QACAC,UAAA;QAEA;QACAX,UAAA;QAEA;QACAY,eAAA;QAEA;QACAC,gBAAA;QAEA;QACAC,MAAA;QAEA;QACAC,cAAA;QAEA;QACAC,aAAA;QAEA;QACAC,MAAA;QAEA;QACA;;QAEA;QACAC,UAAA;QAEA;QACAC,gBAAA;QAEA;QACAC,UAAA;MACA;MACAC,YAAA,GACA;QACAV,UAAA;QACAW,YAAA;MACA,GACA;QACAX,UAAA;QACAW,YAAA;MACA,EACA;MACAC,YAAA,GACA;QACAvB,UAAA;QACAC,QAAA;MACA,GACA;QACAD,UAAA;QACAC,QAAA;MACA;IAEA;EACA;EACAuB,OAAA;IACAC,MAAA;MACA,KAAAvB,UAAA,CAAAC,UAAA;MACA,KAAAD,UAAA,CAAAD,QAAA;MACA,KAAAC,UAAA,CAAAE,MAAA;MACA,KAAAF,UAAA,CAAAG,UAAA;MACA,KAAAH,UAAA,CAAAI,SAAA;MACA,KAAAJ,UAAA,CAAAK,GAAA;MACA,KAAAL,UAAA,CAAAM,OAAA;MACA,KAAAN,UAAA,CAAAO,SAAA;MACA,KAAAP,UAAA,CAAAQ,IAAA;MACA,KAAAR,UAAA,CAAAS,UAAA;MACA,KAAAT,UAAA,CAAAF,UAAA;MACA,KAAAE,UAAA,CAAAU,eAAA;MACA,KAAAV,UAAA,CAAAW,gBAAA;MACA,KAAAX,UAAA,CAAAY,MAAA;MACA,KAAAZ,UAAA,CAAAa,cAAA;MACA,KAAAb,UAAA,CAAAc,aAAA;MACA,KAAAd,UAAA,CAAAe,MAAA;MACA,KAAAf,UAAA,CAAAwB,aA