{"ast":null,"code":"export default {\n  name: \"病案首页\",\n  data() {\n    return {\n      formLabelWidth: '120px',\n      patient: {},\n      centerDialogVisible: '',\n      showAdd: false,\n      search: '',\n      addDisease: '',\n      medicalRecord: {\n        // 病历号的id\n        registerId: '',\n        readme: '',\n        present: '',\n        presentTreat: '',\n        history: '',\n        allergy: '',\n        physique: '',\n        proposal: '',\n        careful: '',\n        diagnosis: '',\n        cure: ''\n      },\n      diseaseList: [{\n        datetime: '2016-05-03',\n        diseaseName: 'Tom',\n        diseaseICD: 'Angeles'\n      }, {\n        datetime: '2016-05-04',\n        diseaseName: 'Tom',\n        diseaseICD: 'No'\n      }, {\n        datetime: '2016-05-01',\n        diseaseName: 'Tom',\n        diseaseICD: 'St'\n      }, {\n        datetime: '2016-05-02',\n        diseaseName: 'Tom',\n        diseaseICD: 'StLos'\n      }],\n      allDiseaseList: [{\n        diseaseName: 'Tom',\n        diseaseICD: 'Angeles'\n      }]\n    };\n  },\n  methods: {\n    onSubmit() {\n      // 判断是否满足条件\n      if (this.medicalRecord.present === '') {\n        this.$message.error('请输入现病史');\n        return;\n      }\n      if (this.medicalRecord.presentTreat === '') {\n        this.$message.error('请输入现病治疗情况');\n        return;\n      }\n      if (this.medicalRecord.history === '') {\n        this.$message.error('请输入既往史');\n        return;\n      }\n      if (this.medicalRecord.allergy === '') {\n        this.$message.error('请输入过敏史');\n        return;\n      }\n      if (this.medicalRecord.physique === '') {\n        this.$message.error('请输入体格检查');\n        return;\n      }\n      if (this.medicalRecord.proposal === '') {\n        this.$message.error('请输入检查建议');\n        return;\n      }\n      // 发送请求添加病历的请求\n      this.medicalRecord.registerId = this.patient.registerId;\n      this.$request.post('/medical-record/add', this.medicalRecord).then(res => {\n        if (res.code === '200') {\n          this.$message.success('保存成功');\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    handleEdit(index, row) {\n      // 传回的是索引和数据\n      console.log(row);\n      alert(index, row.name);\n    },\n    handleDelete(index, row) {\n      alert(index, row);\n    },\n    add() {\n      alert(\"新增\");\n    }\n  },\n  created() {\n    this.patient = localStorage.getItem('patient');\n  },\n  mounted() {}\n};","map":{"version":3,"names":["name","data","formLabelWidth","patient","centerDialogVisible","showAdd","search","addDisease","medicalRecord","registerId","readme","present","presentTreat","history","allergy","physique","proposal","careful","diagnosis","cure","diseaseList","datetime","diseaseName","diseaseICD","allDiseaseList","methods","onSubmit","$message","error","$request","post","then","res","code","success","msg","handleEdit","index","row","console","log","alert","handleDelete","add","created","localStorage","getItem","mounted"],"sources":["src/views/manager/doctors_work/Diagnosis-MedicalRecord.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-form :model=\"medicalRecord\" label-width=\"auto\" style=\"max-width: 95%\">\r\n      <el-form-item label=\"主诉\">\r\n        <el-input placeholder=\"主诉\" v-model=\"medicalRecord.readme\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"现病史\">\r\n        <el-input placeholder=\"现病史\" v-model=\"medicalRecord.present\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"现病治疗情况\">\r\n        <el-input placeholder=\"现病治疗情况\" v-model=\"medicalRecord.presentTreat\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"既往史\">\r\n        <el-input placeholder=\"既往史\" v-model=\"medicalRecord.history\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"过敏史\">\r\n        <el-input placeholder=\"过敏史\" v-model=\"medicalRecord.allergy\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"体格检查\">\r\n        <el-input placeholder=\"体格检查\" v-model=\"medicalRecord.physique\"/>\r\n      </el-form-item>\r\n      <!--    表格-->\r\n      <el-button type=\"primary\" @click=\"showAdd = true\">新增</el-button>\r\n      <el-table\r\n          :data=\"diseaseList\"\r\n          style=\"width: 100%\"\r\n      >\r\n        <el-table-column label=\"ICD编码\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\" margin-left: 10px\">{{ scope.row.diseaseICD }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"名称\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.diseaseName }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"发病时间\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.datetime }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n\r\n\r\n        <el-table-column align=\"right\">\r\n          <template #header>\r\n            <el-input v-model=\"search\" size=\"small\" placeholder=\"search\"/>\r\n          </template>\r\n          <template #default=\"scope\">\r\n            <el-button size=\"small\" @click=\"handleEdit(scope.$index, scope.row)\">\r\n              编辑\r\n            </el-button>\r\n            <el-button\r\n                size=\"small\"\r\n                type=\"danger\"\r\n                @click=\"handleDelete(scope.$index, scope.row)\"\r\n            >\r\n              删除\r\n            </el-button>\r\n          </template>\r\n        </el-table-column>\r\n\r\n      </el-table>\r\n\r\n      <el-form-item label=\"检查建议\">\r\n        <el-input placeholder=\"检查建议\" v-model=\"medicalRecord.proposal\"/>\r\n      </el-form-item>\r\n      <el-form-item label=\"注意事项\">\r\n        <el-input placeholder=\"注意事项\" v-model=\"medicalRecord.careful\"/>\r\n      </el-form-item>\r\n      <el-form-item>\r\n        <el-button type=\"primary\" @click=\"onSubmit\">保存</el-button>\r\n        <el-button>首页</el-button>\r\n      </el-form-item>\r\n\r\n    </el-form>\r\n\r\n    <el-dialog v-model=\"showAdd\" title=\"Shipping address\" width=\"500\">\r\n      <el-form :model=\"allDiseaseList\">\r\n        <el-form-item label=\"疾病\" :label-width=\"formLabelWidth\">\r\n          <el-select v-model=\"addDisease\" placeholder=\"Please select a zone\">\r\n            <el-option label=\"Zone No.1\" value=\"shanghai\"/>\r\n            <el-option label=\"Zone No.2\" value=\"beijing\"/>\r\n          </el-select>\r\n        </el-form-item>\r\n      </el-form>\r\n      <template #footer>\r\n        <div class=\"dialog-footer\">\r\n          <el-button @click=\"dialogFormVisible = false\">Cancel</el-button>\r\n          <el-button type=\"primary\" @click=\"dialogFormVisible = false\">\r\n            Confirm\r\n          </el-button>\r\n        </div>\r\n      </template>\r\n    </el-dialog>\r\n\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: \"病案首页\",\r\n  data() {\r\n    return {\r\n      formLabelWidth: '120px',\r\n\r\n      patient: {},\r\n      centerDialogVisible: '',\r\n      showAdd: false,\r\n      search: '',\r\n      addDisease: '',\r\n      medicalRecord: {\r\n        // 病历号的id\r\n        registerId: '',\r\n        readme: '',\r\n        present: '',\r\n        presentTreat: '',\r\n        history: '',\r\n        allergy: '',\r\n        physique: '',\r\n        proposal: '',\r\n        careful: '',\r\n        diagnosis: '',\r\n        cure: '',\r\n      },\r\n      diseaseList: [\r\n        {\r\n          datetime: '2016-05-03',\r\n          diseaseName: 'Tom',\r\n          diseaseICD: 'Angeles',\r\n        },\r\n        {\r\n          datetime: '2016-05-04',\r\n          diseaseName: 'Tom',\r\n          diseaseICD: 'No',\r\n        },\r\n        {\r\n          datetime: '2016-05-01',\r\n          diseaseName: 'Tom',\r\n          diseaseICD: 'St',\r\n        },\r\n        {\r\n          datetime: '2016-05-02',\r\n          diseaseName: 'Tom',\r\n          diseaseICD: 'StLos',\r\n        }\r\n      ],\r\n      allDiseaseList: [\r\n        {\r\n          diseaseName: 'Tom',\r\n          diseaseICD: 'Angeles',\r\n        },\r\n      ],\r\n    }\r\n  },\r\n  methods: {\r\n    onSubmit() {\r\n      // 判断是否满足条件\r\n      if (this.medicalRecord.present === '') {\r\n        this.$message.error('请输入现病史')\r\n        return\r\n      }\r\n      if (this.medicalRecord.presentTreat === '') {\r\n        this.$message.error('请输入现病治疗情况')\r\n        return\r\n      }\r\n      if (this.medicalRecord.history === '') {\r\n        this.$message.error('请输入既往史')\r\n        return\r\n      }\r\n      if (this.medicalRecord.allergy === '') {\r\n        this.$message.error('请输入过敏史')\r\n        return\r\n      }\r\n      if (this.medicalRecord.physique === '') {\r\n        this.$message.error('请输入体格检查')\r\n        return\r\n      }\r\n      if (this.medicalRecord.proposal === '') {\r\n        this.$message.error('请输入检查建议')\r\n        return\r\n      }\r\n      // 发送请求添加病历的请求\r\n      this.medicalRecord.registerId = this.patient.registerId\r\n      this.$request.post('/medical-record/add', this.medicalRecord).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('保存成功')\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    handleEdit(index, row) {\r\n      // 传回的是索引和数据\r\n      console.log(row)\r\n      alert(index, row.name)\r\n    },\r\n    handleDelete(index, row) {\r\n      alert(index, row)\r\n    },\r\n    add() {\r\n      alert(\"新增\")\r\n    }\r\n  },\r\n  created() {\r\n    this.patient = localStorage.getItem('patient')\r\n  },\r\n  mounted() {\r\n\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AAkHA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,cAAA;MAEAC,OAAA;MACAC,mBAAA;MACAC,OAAA;MACAC,MAAA;MACAC,UAAA;MACAC,aAAA;QACA;QACAC,UAAA;QACAC,MAAA;QACAC,OAAA;QACAC,YAAA;QACAC,OAAA;QACAC,OAAA;QACAC,QAAA;QACAC,QAAA;QACAC,OAAA;QACAC,SAAA;QACAC,IAAA;MACA;MACAC,WAAA,GACA;QACAC,QAAA;QACAC,WAAA;QACAC,UAAA;MACA,GACA;QACAF,QAAA;QACAC,WAAA;QACAC,UAAA;MACA,GACA;QACAF,QAAA;QACAC,WAAA;QACAC,UAAA;MACA,GACA;QACAF,QAAA;QACAC,WAAA;QACAC,UAAA;MACA,EACA;MACAC,cAAA,GACA;QACAF,WAAA;QACAC,UAAA;MACA;IAEA;EACA;EACAE,OAAA;IACAC,SAAA;MACA;MACA,SAAAlB,aAAA,CAAAG,OAAA;QACA,KAAAgB,QAAA,CAAAC,KAAA;QACA;MACA;MACA,SAAApB,aAAA,CAAAI,YAAA;QACA,KAAAe,QAAA,CAAAC,KAAA;QACA;MACA;MACA,SAAApB,aAAA,CAAAK,OAAA;QACA,KAAAc,QAAA,CAAAC,KAAA;QACA;MACA;MACA,SAAApB,aAAA,CAAAM,OAAA;QACA,KAAAa,QAAA,CAAAC,KAAA;QACA;MACA;MACA,SAAApB,aAAA,CAAAO,QAAA;QACA,KAAAY,QAAA,CAAAC,KAAA;QACA;MACA;MACA,SAAApB,aAAA,CAAAQ,QAAA;QACA,KAAAW,QAAA,CAAAC,KAAA;QACA;MACA;MACA;MACA,KAAApB,aAAA,CAAAC,UAAA,QAAAN,OAAA,CAAAM,UAAA;MACA,KAAAoB,QAAA,CAAAC,IAAA,6BAAAtB,aAAA,EAAAuB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAN,QAAA,CAAAO,OAAA;QACA;UACA,KAAAP,QAAA,CAAAC,KAAA,CAAAI,GAAA,CAAAG,GAAA;QACA;MACA;IACA;IACAC,WAAAC,KAAA,EAAAC,GAAA;MACA;MACAC,OAAA,CAAAC,GAAA,CAAAF,GAAA;MACAG,KAAA,CAAAJ,KAAA,EAAAC,GAAA,CAAAtC,IAAA;IACA;IACA0C,aAAAL,KAAA,EAAAC,GAAA;MACAG,KAAA,CAAAJ,KAAA,EAAAC,GAAA;IACA;IACAK,IAAA;MACAF,KAAA;IACA;EACA;EACAG,QAAA;IACA,KAAAzC,OAAA,GAAA0C,YAAA,CAAAC,OAAA;EACA;EACAC,QAAA,GAEA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}