{"ast":null,"code":"export default {\n  name: \"Diagnosis-Check-The-Application\"\n};","map":{"version":3,"names":["name"],"sources":["src/views/manager/Diagnosis-Check-The-Application.vue"],"sourcesContent":["<script>\r\nexport default {\r\n  name: \"Diagnosis-Check-The-Application\"\r\n}\r\n</script>\r\n\r\n<template>\r\n  <div>\r\n    <!--    表格-->\r\n    <el-button type=\"primary\" @click=\"showAdd=true\">新增</el-button>\r\n    <el-table\r\n        :data=\"tableData\"\r\n        style=\"width: 100%\"\r\n    >\r\n      <el-table-column label=\"Date\" width=\"180\">\r\n        <template #default=\"scope\">\r\n          <div style=\"display: flex; align-items: center\">\r\n            <el-icon>\r\n              <timer/>\r\n            </el-icon>\r\n            <span style=\"margin-left: 10px\">{{ scope.row.date }}</span>\r\n          </div>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"Name\" width=\"180\">\r\n        <template #default=\"scope\">\r\n          <el-popover effect=\"light\" trigger=\"hover\" placement=\"top\" width=\"auto\">\r\n            <template #default>\r\n              <div>name: {{ scope.row.name }}</div>\r\n              <div>address: {{ scope.row.address }}</div>\r\n            </template>\r\n            <template #reference>\r\n              <el-tag>{{ scope.row.name }}</el-tag>\r\n            </template>\r\n          </el-popover>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column align=\"right\">\r\n        <template #header>\r\n          <el-input v-model=\"search\" size=\"small\" placeholder=\"search\"/>\r\n        </template>\r\n        <template #default=\"scope\">\r\n          <el-button size=\"small\" @click=\"handleEdit(scope.$index, scope.row)\">\r\n            Edit\r\n          </el-button>\r\n          <el-button\r\n              size=\"small\"\r\n              type=\"danger\"\r\n              @click=\"handleDelete(scope.$index, scope.row)\"\r\n          >\r\n     