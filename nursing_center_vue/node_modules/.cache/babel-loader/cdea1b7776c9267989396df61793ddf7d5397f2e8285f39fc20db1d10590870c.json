{"ast":null,"code":"import Clock from \"@/components/Clock.vue\";\nexport default {\n  name: \"PatientViewing\",\n  components: {\n    Clock\n  },\n  methods: {\n    onSubmit() {\n      console.log('submit!');\n    },\n    info(index, row) {\n      // 传回的是索引和数据\n      console.log(row);\n      alert(index, row.name);\n    },\n    select(index, row) {\n      alert(\"叫号：\" + index, row);\n    },\n    add() {\n      alert(\"新增\");\n    }\n  },\n  created() {\n    this.$request.post('/register/getPatientList', this.employee).then(res => {\n      if (res.code === '200') {\n        console.log(res.data);\n        this.patientTable = res.data;\n        this.noPatientNum = res.data.length;\n        // this.$request.get('/patient/getPatientNum').then(res => {\n        //   this.patientNum = res.data.patientNum || 0\n        // })\n      } else {\n        this.$message.error(res.msg);\n      }\n    });\n  },\n  data() {\n    return {\n      employee: {\n        id: '1',\n        realname: '张三'\n      },\n      patientNum: 12,\n      noPatientNum: 12,\n      patientTable: []\n    };\n  }\n};","map":{"version":3,"names":["Clock","name","components","methods","onSubmit","console","log","info","index","row","alert","select","add","created","$request","post","employee","then","res","code","data","patientTable","noPatientNum","length","$message","error","msg","id","realname","patientNum"],"sources":["src/views/manager/doctors_work/PatientViewing.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-card>\r\n      <h2>患者查看</h2>\r\n      <br>\r\n      <hr>\r\n      <br>\r\n      <Clock/>\r\n    </el-card>\r\n    <el-card style=\"margin-top: 10px\">\r\n      <div slot=\"header\" class=\"clearfix\" style=\"width: 100%\">\r\n        <el-card shadow=\"never\">{{ employee.realName }}医生,您今日已接诊人数: {{ patientNum }}人</el-card>\r\n        <el-card style=\"margin-top: 10px\" shadow=\"never\">{{ employee.realName }}医生,您今日未诊疗人数: {{\r\n            noPatientNum\r\n          }}人\r\n        </el-card>\r\n      </div>\r\n      <div>\r\n        <!--        <el-button type=\"primary\" @click=\"\">叫号</el-button>-->\r\n      </div>\r\n    </el-card>\r\n    <el-card style=\"margin-top: 10px\">\r\n\r\n      <el-table :data=\"patientTable\" style=\"width: 100%\">\r\n        <el-table-column label=\"姓名\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-icon>\r\n                <timer/>\r\n              </el-icon>\r\n              <span style=\"margin-left: 10px\">{{ scope.row.realname }}</span>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"Name\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <el-popover effect=\"light\" trigger=\"hover\" placement=\"top\" width=\"auto\">\r\n              <template #default>\r\n                <div>name: {{ scope.row.name }}</div>\r\n                <div>address: {{ scope.row.address }}</div>\r\n              </template>\r\n              <template #reference>\r\n                <el-tag>{{ scope.row.name }}</el-tag>\r\n              </template>\r\n            </el-popover>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"Operations\">\r\n          <template #default=\"scope\">\r\n            <el-button size=\"small\" @click=\"info(scope.$index, scope.row)\">\r\n              查看详情\r\n            </el-button>\r\n            <el-button\r\n                size=\"small\"\r\n                type=\"danger\"\r\n                @click=\"select(scope.$index, scope.row)\"\r\n            >\r\n              叫号\r\n            </el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n    <Foot/>\r\n  </div>\r\n</template>\r\n<script>\r\nimport Clock from \"@/components/Clock.vue\";\r\n\r\nexport default {\r\n  name: \"PatientViewing\",\r\n  components: {\r\n    Clock\r\n  },\r\n  methods: {\r\n    onSubmit() {\r\n      console.log('submit!');\r\n    },\r\n    info(index, row) {\r\n      // 传回的是索引和数据\r\n      console.log(row)\r\n      alert(index, row.name)\r\n    },\r\n    select(index, row) {\r\n      alert(\"叫号：\" + index, row)\r\n    },\r\n    add() {\r\n      alert(\"新增\")\r\n    },\r\n  },\r\n  created() {\r\n    this.$request.post('/register/getPatientList', this.employee).then(res => {\r\n      if (res.code === '200') {\r\n        console.log(res.data)\r\n        this.patientTable = res.data\r\n        this.noPatientNum = res.data.length\r\n        // this.$request.get('/patient/getPatientNum').then(res => {\r\n        //   this.patientNum = res.data.patientNum || 0\r\n        // })\r\n      } else {\r\n        this.$message.error(res.msg)\r\n      }\r\n    })\r\n  },\r\n  data() {\r\n    return {\r\n      employee: {\r\n        id: '1',\r\n        realname: '张三',\r\n      },\r\n      patientNum: 12,\r\n      noPatientNum: 12,\r\n      patientTable: [],\r\n    }\r\n  },\r\n}\r\n</script>\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AAqEA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAF;EACA;EACAG,OAAA;IACAC,SAAA;MACAC,OAAA,CAAAC,GAAA;IACA;IACAC,KAAAC,KAAA,EAAAC,GAAA;MACA;MACAJ,OAAA,CAAAC,GAAA,CAAAG,GAAA;MACAC,KAAA,CAAAF,KAAA,EAAAC,GAAA,CAAAR,IAAA;IACA;IACAU,OAAAH,KAAA,EAAAC,GAAA;MACAC,KAAA,SAAAF,KAAA,EAAAC,GAAA;IACA;IACAG,IAAA;MACAF,KAAA;IACA;EACA;EACAG,QAAA;IACA,KAAAC,QAAA,CAAAC,IAAA,kCAAAC,QAAA,EAAAC,IAAA,CAAAC,GAAA;MACA,IAAAA,GAAA,CAAAC,IAAA;QACAd,OAAA,CAAAC,GAAA,CAAAY,GAAA,CAAAE,IAAA;QACA,KAAAC,YAAA,GAAAH,GAAA,CAAAE,IAAA;QACA,KAAAE,YAAA,GAAAJ,GAAA,CAAAE,IAAA,CAAAG,MAAA;QACA;QACA;QACA;MACA;QACA,KAAAC,QAAA,CAAAC,KAAA,CAAAP,GAAA,CAAAQ,GAAA;MACA;IACA;EACA;EACAN,KAAA;IACA;MACAJ,QAAA;QACAW,EAAA;QACAC,QAAA;MACA;MACAC,UAAA;MACAP,YAAA;MACAD,YAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}