{"ast":null,"code":"export default {\n  name: \"开设处方\",\n  data() {\n    return {\n      form: {\n        sumMoney: '360.00'\n      },\n      PrescribingList: [{\n        drugName: '阿司匹林',\n        specification: '100mg',\n        dosage: '1次/天',\n        price: '20.00',\n        count: '3'\n      }, {\n        drugName: 'cipl',\n        specification: '100mg',\n        dosage: '1次/天',\n        price: '20.00',\n        count: '3'\n      }, {\n        drugName: '',\n        specification: '',\n        dosage: '',\n        price: '',\n        count: '1'\n      }, {\n        drugName: '',\n        specification: '',\n        dosage: '',\n        price: '',\n        count: '2'\n      }, {\n        drugName: '',\n        specification: '',\n        dosage: '',\n        price: '',\n        count: '1'\n      }]\n    };\n  },\n  methods: {\n    onSubmit() {\n      console.log('submit!');\n    },\n    handleEdit(index, row) {\n      // 传回的是索引和数据\n      console.log(row);\n      alert(index, row.name);\n    },\n    handleDelete(index, row) {\n      alert(index, row);\n    },\n    add() {\n      alert(\"新增\");\n    },\n    addCount() {\n      alert(\"增加数量\");\n    },\n    subCount() {\n      alert(\"减少数量\");\n    }\n  }\n};","map":{"version":3,"names":["name","data","form","sumMoney","PrescribingList","drugName","specification","dosage","price","count","methods","onSubmit","console","log","handleEdit","index","row","alert","handleDelete","add","addCount","subCount"],"sources":["src/views/manager/doctors_work/Diagnosis-Prescribing.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <hr/>\r\n    <el-tag type=\"success\" style=\"font-size: 20px;width: 500px;height: 30px;margin-top: 10px\">\r\n\r\n      <div style=\"margin-top: 5px\">\r\n        本项目金额合计:\r\n        {{ form.sumMoney || 0.00 }}元\r\n      </div>\r\n\r\n    </el-tag>\r\n    <br>\r\n    <el-button type=\"primary\" @click=\"add\">新增</el-button>\r\n    <el-table :data=\"PrescribingList\" style=\"width: 100%\">\r\n\r\n      <el-table-column label=\"药品名称\" width=\"180\">\r\n        <template #default=\"scope\">\r\n          <div style=\"display: flex; align-items: center\">\r\n            <el-icon>\r\n              <timer/>\r\n            </el-icon>\r\n            <span style=\"margin-left: 10px\">{{ scope.row.drugName }}</span>\r\n          </div>\r\n        </template>\r\n      </el-table-column>\r\n\r\n      <el-table-column label=\"规格\" width=\"180\">\r\n        <template #default=\"scope\">\r\n          <div style=\"display: flex; align-items: center\">\r\n            <el-icon>\r\n              <timer/>\r\n            </el-icon>\r\n            <span style=\"margin-left: 10px\">{{ scope.row.specification }}</span>\r\n          </div>\r\n        </template>\r\n      </el-table-column>\r\n\r\n      <el-table-column label=\"用法用量\" width=\"180\">\r\n        <template #default=\"scope\">\r\n          <div style=\"display: flex; align-items: center\">\r\n            <el-icon>\r\n              <timer/>\r\n            </el-icon>\r\n            <span style=\"margin-left: 10px\">{{ scope.row.dosage }}</span>\r\n          </div>\r\n        </template>\r\n      </el-table-column>\r\n\r\n      <el-table-column label=\"单价(元)\" width=\"180\">\r\n        <template #default=\"scope\">\r\n          <div style=\"display: flex; align-items: center\">\r\n            <el-icon>\r\n              <timer/>\r\n            </el-icon>\r\n            <span style=\"margin-left: 10px\">{{ scope.row.price }}</span>\r\n          </div>\r\n        </template>\r\n      </el-table-column>\r\n\r\n      <el-table-column label=\"数量\" width=\"180\">\r\n        <template #default=\"scope\">\r\n          <div style=\"display: flex; align-items: center\">\r\n            <el-icon>\r\n              <timer/>\r\n            </el-icon>\r\n            <span style=\"margin-left: 10px\">\r\n              <span>\r\n                <el-button type=\"primary\" @click=\"addCount()\">+</el-button>\r\n              </span>\r\n              {{ scope.row.count }}\r\n              <span>\r\n                <el-button type=\"primary\" @click=\"subCount()\">-</el-button>\r\n              </span>\r\n            </span>\r\n          </div>\r\n        </template>\r\n      </el-table-column>\r\n\r\n      <el-table-column label=\"操作\">\r\n        <template #default=\"scope\">\r\n          <el-button size=\"small\" @click=\"handleEdit(scope.$index, scope.row)\">\r\n            编辑\r\n          </el-button>\r\n          <el-button\r\n              size=\"small\"\r\n              type=\"danger\"\r\n              @click=\"handleDelete(scope.$index, scope.row)\"\r\n          >\r\n            删除\r\n          </el-button>\r\n        </template>\r\n      </el-table-column>\r\n    </el-table>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: \"开设处方\",\r\n\r\n  data() {\r\n    return {\r\n      form: {\r\n        sumMoney: '360.00',\r\n      },\r\n      PrescribingList: [\r\n        {\r\n          drugName: '阿司匹林',\r\n          specification: '100mg',\r\n          dosage: '1次/天',\r\n          price: '20.00',\r\n          count: '3',\r\n        },\r\n        {\r\n          drugName: 'cipl',\r\n          specification: '100mg',\r\n          dosage: '1次/天',\r\n          price: '20.00',\r\n          count: '3',\r\n        },\r\n        {\r\n          drugName: '',\r\n          specification: '',\r\n          dosage: '',\r\n          price: '',\r\n          count: '1',\r\n        },\r\n        {\r\n          drugName: '',\r\n          specification: '',\r\n          dosage: '',\r\n          price: '',\r\n          count: '2',\r\n        },\r\n        {\r\n          drugName: '',\r\n          specification: '',\r\n          dosage: '',\r\n          price: '',\r\n          count: '1',\r\n        },\r\n      ],\r\n    }\r\n  },\r\n  methods: {\r\n    onSubmit() {\r\n      console.log('submit!');\r\n    },\r\n    handleEdit(index, row) {\r\n      // 传回的是索引和数据\r\n      console.log(row)\r\n      alert(index,