<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.nursing_center.mapper.CareProjectMapper">
    <select id="getData" resultType="com.example.nursing_center.pojo.CareProject">
        SELECT * FROM care_project where status="1"
    </select>
    <select id="myListPage" resultType="com.example.nursing_center.pojo.CareProject">
        SELECT * FROM care_project
        limit #{pageNum},#{pageSize}
    </select>
    <select id="select" resultType="com.example.nursing_center.pojo.CareProject">
        SELECT * FROM care_project where status="1"

            <if test="projectName!=null">
                AND project_name like "%"#{projectName}"%"
            </if>
            <if test="minPrice!=0">
                AND price &gt;= #{minPrice}
            </if>
            <if test="maxPrice!=0">
                AND price &lt;= #{maxPrice}
            </if>

        limit #{pageNum},#{pageSize}
    </select>
    <update id="changeActive">
        UPDATE care_project
        SET is_active = #{active}
        WHERE project_id = #{projectId}
    </update>
    <insert id="addProject" parameterType="com.example.nursing_center.pojo.CareProject">
        INSERT INTO care_project(project_name,description,service_duration,price,frequency,nurse_level)
        VALUES(#{projectName},#{description},#{serviceDuration},#{price},#{frequency},#{nurseLevel})
    </insert>
    <update id="deleteProject">
        UPDATE care_project
        SET status = "0"
        WHERE project_id = #{projectId}
    </update>
    <update id="updateProject" parameterType="com.example.nursing_center.pojo.CareProject">
        UPDATE care_project
        SET project_name = #{projectName},description = #{description},service_duration = #{serviceDuration},price = #{price},frequency = #{frequency},nurse_level = #{nurseLevel},updated_at = Now()
        WHERE project_id = #{projectId}
    </update>
    <select id="getLength" resultType="int">
        select count(*) from care_project;
    </select>
    <select id="getProjectName" resultType="com.example.nursing_center.pojo.CareProject">
        select project_id,project_name from care_project;
    </select>
</mapper>
