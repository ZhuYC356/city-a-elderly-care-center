<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.nursing_center.mapper.NoticeMapper">
    <insert id="add">
        insert into notice(title, content, time, user)
        values (#{title}, #{content}, now(), #{user})
    </insert>

    <select id="gatAll" resultType="com.example.nursing_center.pojo.Notice">
        select *
        from notice
    </select>
</mapper>
