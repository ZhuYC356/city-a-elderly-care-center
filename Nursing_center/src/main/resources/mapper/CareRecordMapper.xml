<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.nursing_center.mapper.CareRecordMapper">



    <select id="getRecord" resultType="com.example.nursing_center.controller.Result.RecordForm">

                    select * from service_concern_and_record;

    </select>
    <select id="select" resultType="com.example.nursing_center.controller.Result.RecordForm">
        <!--SELECT
        ei.elderly_id,              &#45;&#45; 老人ID
        ei.name AS elderly_name,    &#45;&#45; 老人姓名
        ei.id_number,               &#45;&#45; 老人身份证号
        cp.project_name AS project_name,            &#45;&#45; 护理项目名称
        cp.nurse_level,             &#45;&#45; 护理等级
        ni.name AS nurse_name,      &#45;&#45; 护工姓名
        cr.care_status              &#45;&#45; 护理状态
        FROM
        care_record cr
        JOIN
        elderly_info ei ON cr.elderly_id = ei.elderly_id  &#45;&#45; 连接老人信息表
        JOIN
        care_project cp ON cr.project_id = cp.project_id  &#45;&#45; 连接护理项目信息表
        JOIN
        nurse_info ni ON cr.nurse_id = ni.nurse_id       &#45;&#45; 连接护工信息表
        WHERE
        1 = 1 &#45;&#45; 作为条件的默认值，用于连接动态条件
        <if test="elderlyName != null and elderlyName != ''">
            AND ei.name LIKE CONCAT('%', #{elderlyName}, '%') &#45;&#45; 根据老人姓名模糊查询
        </if>
        <if test="projectName != null and projectName != ''">
            AND cp.project_name LIKE CONCAT('%', #{projectName}, '%') &#45;&#45; 根据护理项目名称模糊查询
        </if>
        AND cr.status = '1'; &#45;&#45; 仅查询状态为1的有效记录-->
        select * from service_concern_and_record
        where name like concat('%',#{name},'%')
          and project_name like concat('%',#{projectName},'%')
    </select>
    <select id="getRecordById" resultType="com.example.nursing_center.controller.Result.RecordForm">
        SELECT
            sc.elderly_id AS elderlyId,
            sc.name AS name,
            sc.gender AS gender,
            sc.age AS age,
            sc.id_number AS idNumber,
            sc.nurse_name AS nurseName,
            sc.project_id AS projectId,
            sc.project_name AS projectName,
            sc.description AS description,
            sc.care_status AS careStatus,
            sc.price AS price,
            sc.service_duration AS serviceDuration
        FROM service_concern_and_record sc
        WHERE elderly_id = #{elderlyId} and project_id = #{projectId}

    </select>
    <select id="getCareStatus" resultType="String">
        SELECT care_status FROM service_concern_and_record
        WHERE elderly_id = #{elderlyId}
        AND project_id = #{projectId}
    </select>


    <update id="updateCareStatus">
        UPDATE elderly_and_project
        SET status = #{careStatus}
        WHERE elderly_id = #{elderlyId} AND project_id = #{projectId}
    </update>

    <!--服务关注的表格查询语句-->
    <select id="getAllElderlyProjects" resultMap="elderlyProjectResultMap">
        SELECT
        sc.elderly_id AS elderlyId,
        sc.name AS name,
        sc.gender AS gender,
        sc.age AS age,
        sc.id_number AS idNumber,
        sc.nurse_name AS nurseName,
        sc.project_name AS projectName,
        sc.description AS description,
        sc.care_status AS careStatus,
        sc.price AS price,
        sc.service_duration AS serviceDuration
        FROM service_concern_and_record sc
        <if test="name != null and name != ''">
            WHERE sc.name LIKE CONCAT('%', #{name}, '%')
        </if>
    </select>



    <resultMap id="elderlyProjectResultMap" type="com.example.nursing_center.controller.Result.ServiceConcern">
        <id property="idNumber" column="idNumber"/>
        <result property="name" column="name"/>
        <result property="gender" column="gender"/>
        <result property="age" column="age"/>
        <result property="nurseName" column="nurseName"/>
        <collection property="careProjectForElderlyList" ofType="com.example.nursing_center.controller.Result.CareProjectForElderly">
            <result property="projectName" column="projectName"/>
            <result property="description" column="description"/>
            <result property="careStatus" column="careStatus"/>
            <result property="price" column="price"/>
            <result property="careEndTime" column="serviceDuration"/>
        </collection>
    </resultMap>

</mapper>
