<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.nursing_center.mapper.CheckOutRequestsMapper">

    <select id="selectAll" resultType="java.lang.Object">
        select * from check_out_requests,elderly_info where check_out_requests.elderly_id=elderly_info.elderly_id
    </select>
    <select id="selectName" resultType="java.lang.Object"></select>
    <select id="selectBedId" resultType="java.lang.Object"></select>
    <select id="selectDate" resultType="java.lang.Object"></select>
    <select id="getAll" resultType="java.lang.Object"></select>
</mapper>
