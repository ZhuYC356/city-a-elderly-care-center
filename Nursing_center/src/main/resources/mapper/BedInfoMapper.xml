<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.nursing_center.mapper.BedInfoMapper">

    <insert id="add">
        insert into bed_info(bed_number,bed_type,bed_status,floor_number,room_number,floor)
        values(#{bedNumber},#{bedType},#{bedStatus},#{floorNumber},#{roomNumber},#{floor})
    </insert>
    <select id="getAll" resultType="com.example.nursing_center.controller.Result.ManagerElder">
        select * from bed_info,elderly_info where bed_info.bed_id=elderly_info.bed_id;
    </select>
    <select id="select" parameterType="com.example.nursing_center.controller.Result.Form" resultType="com.example.nursing_center.controller.Result.ManagerElder">
        select * from bed_info,elderly_info where bed_info.bed_id=elderly_info.bed_id;
    </select>
</mapper>
